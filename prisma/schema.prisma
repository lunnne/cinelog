generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  username      String?           @unique      // optional for OAuth users
  email         String?           @unique
  password      String?                         // null if user used OAuth
  profileImage  String?                          // avatar
  createdAt     DateTime          @default(now())

  // Relations
  followers     Follow[]          @relation("followerRelation")
  following     Follow[]          @relation("followingRelation")
  likes         Like[]
  reviews       Review[]
  movieStatuses UserMovieStatus[]

  // NextAuth Relations
  accounts      Account[]         
  sessions      Session[]        

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id                  Int      @id
  title               String
  originalTitle       String?
  overview            String?
  tagline             String?
  posterUrl           String?
  backdropUrl         String?
  releaseDate         String?
  runtime             Int?
  voteAverage         Float?
  genres              String[] // e.g. ["액션", "스릴러"]
  productionCompanies String[] // e.g. ["Revolution Studios"]
  productionCountries String[] // e.g. ["United States of America"]
  spokenLanguages     String[] // e.g. ["English", "Russian"]
  createdAt           DateTime @default(now())

  // Relations
  reviews  Review[]
  statuses UserMovieStatus[]
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  rating    Int
  comment   String
  emotion   String
  location  String
  friend    String
  likes     Int      @default(0)
  replies   Int      @default(0)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Like      Like[]

  @@unique([userId, movieId])
  @@map("reviews")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("likes")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("followerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followingRelation", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model UserMovieStatus {
  id        String   @id @default(uuid())
  userId    String
  movieId   Int
  status    Status
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("user_movie_statuses")
}

enum Status {
  WATCHLIST
  WATCHED
}
